<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= title %> - Faturé</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    * { box-sizing: border-box; }
    html, body { 
      margin: 0; 
      padding: 0; 
      font-family: 'Poppins', sans-serif; 
      background-color: #f8f9fa; 
      color: #333; 
      overflow-x: hidden !important;
      width: 100%;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      background: linear-gradient(135deg, #0f1c36, #1e3c72);
      color: white;
      padding: 0 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 70px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
      position: sticky;
      top: 0;
      z-index: 1000;
      width: 100%;
    }

    .nav-brand .brand-link {
      color: #FFD700;
      font-family: 'Playfair Display', serif;
      font-weight: 900;
      font-size: 28px;
      text-decoration: none;
      letter-spacing: 4px;
      text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .nav-links { display: flex; gap: 5px; align-items: center; }
    .nav-links a {
      color: rgba(255, 255, 255, 0.85);
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
      padding: 10px 18px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: background 0.3s, color 0.3s;
    }
    .nav-links a:hover { background: rgba(255, 215, 0, 0.15); color: #FFD700; }

    .nav-auth { display: flex; align-items: center; gap: 15px; }
    .nav-auth span {
      color: #e0e0e0;
      font-size: 14px;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-auth span i { font-size: 20px; color: #FFD700; }

    .btn-logout {
      background: transparent;
      color: #FFD700;
      padding: 8px 20px;
      border-radius: 20px;
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      border: 1px solid #FFD700;
      cursor: pointer;
      transition: 0.3s;
    }
    .btn-logout:hover { background: #FFD700; color: #0f1c36; }

    .btn-auth {
      color: #0f1c36;
      background: #FFC107;
      padding: 8px 20px;
      border-radius: 20px;
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      transition: background 0.3s;
    }
    .btn-auth:hover { background: #FFD700; }

    /* ===== HAMBURGER ===== */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      cursor: pointer;
      z-index: 1001;
      width: 42px;
      height: 42px;
      border-radius: 8px;
      transition: background 0.3s;
      flex-shrink: 0;
    }
    .hamburger:hover { background: rgba(255, 215, 0, 0.1); }
    .hamburger span {
      width: 24px;
      height: 2.5px;
      background: #FFD700;
      border-radius: 5px;
      transition: all 0.3s ease;
      display: block;
    }

    /* ===== OVERLAY ===== */
    .nav-overlay {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.6);
      z-index: 999;
      backdrop-filter: blur(2px);
    }
    .nav-overlay.active { display: block; }

    .content { padding: 0; min-height: calc(100vh - 150px); width: 100%; overflow-x: hidden; }

    /* ===== MOBILE (Layar HP & Tablet ≤ 900px) ===== */
    @media (max-width: 900px) {
      .navbar {
        padding: 0 16px;
        height: 60px;
      }
      .nav-brand .brand-link {
        font-size: 22px;
        letter-spacing: 3px;
      }
      .hamburger { display: flex; }

      .nav-right {
        position: fixed;
        top: 60px;
        right: 0;
        width: 280px;
        height: calc(100vh - 60px);
        background: linear-gradient(180deg, #0d1a30, #162d54);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 0;
        overflow-y: auto;
        transform: translateX(100%);
        transition: transform 0.3s ease-in-out;
        box-shadow: -5px 0 30px rgba(0,0,0,0.5);
        z-index: 1000;
      }
      .navbar.active .nav-right {
        transform: translateX(0);
      }

      .nav-links {
        flex-direction: column;
        padding: 16px 0;
        border-bottom: 1px solid rgba(255,215,0,0.12);
        gap: 2px;
      }
      .nav-links a {
        width: 100%;
        justify-content: flex-start;
        padding: 13px 24px;
        border-radius: 0;
        font-size: 15px;
      }
      .nav-links a:hover {
        background: rgba(255, 215, 0, 0.1);
        padding-left: 30px;
        color: #FFD700;
      }

      .nav-auth {
        flex-direction: column;
        padding: 20px 24px;
        gap: 12px;
        align-items: stretch;
      }
      .nav-auth span {
        justify-content: flex-start;
        padding: 8px 0 16px;
        font-size: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .nav-auth .btn-logout,
      .nav-auth .btn-auth {
        text-align: center;
        display: block;
        padding: 12px;
        font-size: 14px;
      }

      .navbar.active .hamburger span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
      .navbar.active .hamburger span:nth-child(2) { opacity: 0; }
      .navbar.active .hamburger span:nth-child(3) { transform: rotate(-45deg) translate(6px, -6px); }
    }

    @media (max-width: 480px) {
      .navbar { padding: 0 12px; height: 56px; }
      .nav-brand .brand-link { font-size: 20px; letter-spacing: 2px; }
      .nav-right { top: 56px; width: 80%; height: calc(100vh - 56px); }
    }
  </style>
</head>
<body>

<nav class="navbar" id="navbar">
  <div class="nav-brand">
    <a href="/" class="brand-link">FATURÉ</a>
  </div>

  <div class="hamburger" onclick="toggleMenu()">
    <span></span><span></span><span></span>
  </div>

  <div class="nav-right">
    <div class="nav-links">
      <% if (!user || user.role !== 'admin') { %>
        <a href="/"><i class="fas fa-home"></i> Home</a>
        <a href="/about"><i class="fas fa-info-circle"></i> About</a>
        <a href="/products"><i class="fas fa-store"></i> Produk</a>
      <% } %>

      <% if (user && user.role === 'customer') { %>
        <a href="/cart"><i class="fas fa-shopping-cart"></i> Keranjang</a>
        <a href="/my-orders"><i class="fas fa-box"></i> Pesanan</a>
      <% } %>

      <% if (user && user.role === 'admin') { %>
        <a href="/"><i class="fas fa-home"></i> Home</a>
        <a href="/admin/products"><i class="fas fa-cubes"></i> Produk</a>
        <a href="/customers"><i class="fas fa-users"></i> Customer</a>
        <a href="/orders"><i class="fas fa-receipt"></i> Order</a>
        <a href="/admin/settings"><i class="fas fa-cogs"></i> Setting</a>
      <% } %>
    </div>

    <div class="nav-auth">
      <% if (user) { %>
        <span><i class="fas fa-user-circle"></i> <%= user.username %></span>
        <a href="/logout" class="btn-logout">Keluar</a>
      <% } else { %>
        <a href="/login" class="btn-auth">Masuk</a>
        <a href="/register" class="btn-auth">Daftar</a>
      <% } %>
    </div>
  </div>
</nav>

<div class="nav-overlay" id="nav-overlay" onclick="toggleMenu()"></div>

<script>
function toggleMenu() {
  document.getElementById('navbar').classList.toggle('active');
  document.getElementById('nav-overlay').classList.toggle('active');
}
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.nav-right a').forEach(function(link) {
    link.addEventListener('click', function() {
      if (window.innerWidth <= 900) {
        document.getElementById('navbar').classList.remove('active');
        document.getElementById('nav-overlay').classList.remove('active');
      }
    });
  });
});
</script>

<div class="content">
